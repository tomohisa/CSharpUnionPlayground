<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework>
    <WarningsAsErrors>25;3261</WarningsAsErrors><Nullable>enable</Nullable>
